# Copie este arquivo para ".env" e preencha. O ".env" está no .gitignore.
# Só é lido quando o main.py roda com --AWS.

# Credenciais (lidas pelo boto3). Alternativa: AWS_PROFILE=<perfil do `aws configure`>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Região com SV1: us-east-1, us-west-1, us-west-2 ou eu-west-2
AWS_REGION=us-east-1

# Bucket S3 onde o Braket grava os resultados das tarefas
# (padrão criado ao habilitar o Braket: amazon-braket-<regiao>-<id-da-conta>)
BRAKET_S3_BUCKET=
BRAKET_S3_PREFIX=qaoa-tsptw

# Opcional: simulador a usar (padrão: SV1)
# BRAKET_DEVICE_ARN=arn:aws:braket:::device/quantum-simulator/amazon/sv1
